{
  "name": "theisen-recipes",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages": "npm run build && wrangler pages dev dist --compatibility-date=2026-11-26",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p functions/tsconfig.json",
    "check": "vitest run && tsc -b && tsc -p functions/tsconfig.json && vite build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.51.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
