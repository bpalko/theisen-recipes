# Copy to `.dev.vars` for `wrangler pages dev` (never commit real secrets).
# In Cloudflare Pages, set these as production secrets / environment variables.

# Shared family password. Required in production — the bookshelf will not load without it.
BOOKSHELF_PASSWORD=replace-me-with-the-family-password

# HMAC key for the signed session cookie. Use a long random string in production.
SESSION_SECRET=replace-me-with-a-long-random-string

# Family recipes and photos are stored in an R2 bucket bound as RECIPES
# (see wrangler.jsonc). Create it with:
#   pnpm wrangler r2 bucket create theisen-recipes
#
# Optional hard cap on total R2 usage, in bytes. Must be a positive integer.
# Defaults to 5 GiB (5368709120) so the bookshelf stays well below R2's 10 GB free tier.
# MAX_BUCKET_BYTES=5368709120
